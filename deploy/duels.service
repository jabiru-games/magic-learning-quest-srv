# Service systemd utilisateur : copier dans ~/.config/systemd/user/, puis
#   systemctl --user daemon-reload && systemctl --user enable --now duels
# Pour qu’il tourne sans session ouverte : sudo loginctl enable-linger <compte>
[Unit]
Description=Magic Learning Quest duel server
After=network.target

[Service]
WorkingDirectory=%h/apps/magic-learning-quest-srv
ExecStart=/usr/bin/node index.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=ALLOWED_ORIGINS=https://jabiru-games.github.io
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
